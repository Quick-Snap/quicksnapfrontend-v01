# Copy to `.env.local` and fill in values.

# --- Google OAuth (Web client) ---
# Use the same OAuth client as the backend validates (GOOGLE_CLIENT_ID on the API must match,
# or include this client id in the backend’s comma-separated GOOGLE_CLIENT_ID list).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth.js / NextAuth (v5) ---
# Public URL of this Next.js app (no trailing slash). Required for OAuth redirects.
# Must match the origin you use in the browser (including port), e.g. http://localhost:3001 if `next dev -p 3001`.
NEXTAUTH_URL=http://localhost:3000
# Random secret for encrypting the session cookie. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Auth.js v5 also accepts these aliases (optional):
# AUTH_SECRET=          # same as NEXTAUTH_SECRET
# AUTH_URL=             # same as NEXTAUTH_URL

# --- Backend Express API ---
# Used by `app/api/axios` and most API calls (includes `/api` path).
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Optional: API origin without `/api`. When set, Google token exchange calls:
#   {BACKEND_URL}/api/auth/google
# If omitted, the same request URL is built from NEXT_PUBLIC_API_URL as:
#   {NEXT_PUBLIC_API_URL}/auth/google
# BACKEND_URL=http://localhost:5001

# --- Google Cloud Console ---
# Authorized redirect URI (exact):
#   {NEXTAUTH_URL}/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
# Authorized JavaScript origins: origin only, e.g. http://localhost:3000 and your production origin.

# --- App Router server auth ---
# Use `import { auth } from "@/auth"` instead of getServerSession — e.g. `const session = await auth()`.
# Client components can use `useSession()` from `next-auth/react`; `session.accessToken` is the backend JWT.
